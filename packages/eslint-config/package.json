{
  "name": "@angusp/eslint-config",
  "version": "0.1.0",
  "description": "Shared ESLint flat configs for @angusp projects",
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    "./javascript": "./javascript.js",
    "./typescript": "./typescript.js",
    "./node": "./node.js",
    "./react": "./react.js",
    "./vue": "./vue.js"
  },
  "files": [
    "*.js"
  ],
  "dependencies": {
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-n": "^17.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
